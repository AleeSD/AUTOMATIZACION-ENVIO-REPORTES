# Referencia solamente. No se carga automáticamente.
WHATSAPP_MODE=simulation
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=
META_ALLOWED_RECIPIENTS=
# El script configurar_meta.cmd guarda el token nuevo cifrado en
# config/meta.local.json; whatsapp.ps1 lo pasa temporalmente por entorno.
# La generacion permanece en simulation; solo whatsapp --send envia.
# Para servidor local, generar un secreto propio de 24 o más caracteres:
GPS_LOCAL_TOKEN=
